# Career Fit Explainer agent (career_fit_agent/) -- copy to .env and fill in
# real values. Every value below is optional: with nothing set, the agent
# runs fully in local/offline mode against mock_scenarios/ data.

# Zetaris Lightning REST endpoint for live federated queries across the real
# job_fetcher.db / company-signal feed / market-data feed. Unset -> the
# ZetarisFederatedStore federates the sample JSON files in-process instead.
ZETARIS_ENDPOINT=
ZETARIS_API_KEY=

# Meterless usage-ingest endpoint. Unset -> usage events are still written
# locally to logs/meterless_usage.jsonl, just not forwarded.
METERLESS_ENDPOINT=https://api.meterless.dev
METERLESS_API_KEY=

# Enables AnthropicReasoner for the Explainer's narrative step. Unset -> a
# deterministic heuristic narrative is used instead (same underlying facts).
ANTHROPIC_API_KEY=
CAREER_FIT_MODEL=claude-sonnet-5-5
